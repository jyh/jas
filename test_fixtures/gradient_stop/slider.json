            "opacity": 100,
            "location": 0,
            "midpoint_to_next": 50
          },
          {
            "color": "#cc0033",
            "opacity": 100,
            "location": 10,
            "midpoint_to_next": 50
          },
          {
            "color": "#0000ff",
            "opacity": 100,
            "location": 100,
            "midpoint_to_next": 40
          }
        ],
        "index": 1
      }
    },
    {
      "name": "add_honours_the_midpoint_above_it",
      "op": "add_stop",
      "_comment": "m = 0.25 and t = 0.25 = m, so u = 0.5 exactly: 127.5 rounds half UP to 128 (80) on both channels. A banker's rounding gives 128 too, so the next vector carries the half-up witness.",
