      "_comment": "A plain set on the selected stop; order, locations, opacities and midpoints are untouched, and the index stays.",
      "stops": [
        {
          "color": "#ff0000",
          "opacity": 100,
          "location": 0,
          "midpoint_to_next": 40
        },
        {
          "color": "#00ff00",
          "opacity": 100,
          "location": 50,
          "midpoint_to_next": 40
        },
        {
          "color": "#0000ff",
          "opacity": 100,
          "location": 100,
          "midpoint_to_next": 40
        }
