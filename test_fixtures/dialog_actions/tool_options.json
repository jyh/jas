 {
  "name": "eyedropper_ok_unticks_fill_and_keeps_the_rest",
  "setup_svg": "rect_with_stroke.svg",
  "note": "fill and stroke both start true (state.yaml); the press unticks fill, and OK must carry the untouched stroke through as true.",
  "actions": [
   {"open_dialog": {"id": "eyedropper_tool_options"}},
   {"dialog_event": {"address": {"id": "eto_fill"}, "event": "click"}},
   {"dialog_event": {"address": {"action": "eyedropper_tool_options_confirm", "label": "OK"}, "event": "click"}}
