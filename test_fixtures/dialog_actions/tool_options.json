[
 {
  "name": "paintbrush_reset_restores_the_dialog_defaults",
  "setup_svg": "rect_with_stroke.svg",
  "actions": [
   {"open_dialog": {"id": "paintbrush_tool_options"}},
   {"dialog_event": {"address": {"id": "pto_fidelity"}, "event": "commit", "value": "5"}},
   {"dialog_event": {"address": {"id": "pto_fill_new_strokes"}, "event": "click"}},
   {"dialog_event": {"address": {"action": "paintbrush_tool_options_reset"}, "event": "click"}}
  ],
  "expected_dialog": {"id": "paintbrush_tool_options", "state": {"fidelity": 3, "fill_new_strokes": false, "keep_selected": true, "edit_selected_paths": true, "edit_within": 12}},
  "expected_document": "unchanged"
 },
 {
  "name": "paintbrush_ok_stores_what_was_edited",
  "setup_svg": "rect_with_stroke.svg",
  "actions": [
   {"open_dialog": {"id": "paintbrush_tool_options"}},
   {"dialog_event": {"address": {"id": "pto_fidelity"}, "event": "commit", "value": "5"}},
   {"dialog_event": {"address": {"id": "pto_fill_new_strokes"}, "event": "click"}},
   {"dialog_event": {"address": {"action": "paintbrush_tool_options_confirm", "label": "OK"}, "event": "click"}}
  ],
  "expected_dialog": null,
  "expected_state": {"paintbrush_fidelity": 5, "paintbrush_fill_new_strokes": true},
  "expected_document": "unchanged"
 },
 {
