  {
    "name": "repeat_boolean_operation_reapplies_the_remembered_union",
    "setup_svg": "overlapping_rects.svg",
    "note": "boolean.yaml menu Repeat Boolean Operation; actions.yaml repeat_boolean_operation fires the operation state.last_boolean_op names on the current selection. With 'union' remembered, Select All then Repeat must leave exactly the document the action corpus pins for a union of the same two rects, so the golden is that file, not a copy (flask STATUS 547 finding F: the engine refused the row).",
    "state": {
      "last_boolean_op": "union"
    },
    "actions": [
      {
        "action": "select_all"
      },
      {
        "panel_menu": {
          "panel": "boolean_panel_content",
          "address": {
            "action": "repeat_boolean_operation"
          }
        }
      }
    ],
    "expected_json": "../actions/boolean_union_overlapping_rects_expected.json"
  },
  {
    "name": "swatch_options_ok_edits_the_selected_swatch",
    "setup_svg": "rect_basic.svg",
    "note": "swatches.yaml menu Swatch Options... (open_swatch_options, mode edit) opens on the selected swatch; a new name and hex, then OK (swatch_options_confirm -> swatch.store, edit mode) REPLACES that swatch: name and '#rrggbb' lower-case colour, the library's length unchanged.",
    "panel_state": {
      "swatches_panel_content": {
        "selected_library": "web_colors",
        "selected_swatches": [
          3
        ]
      }
    },
    "actions": [
      {
        "panel_menu": {
          "panel": "swatches_panel_content",
          "address": {
            "action": "open_swatch_options"
          }
        }
      },
      {
        "dialog_event": {
          "address": {
            "id": "so_name_input"
          },
          "event": "commit",
          "value": "Navy Three"
        }
      },
      {
        "dialog_event": {
          "address": {
            "id": "so_hex"
          },
          "event": "commit",
          "value": "1A2B3C"
        }
      },
      {
        "dialog_event": {
          "address": {
            "action": "swatch_options_confirm",
            "label": "OK"
          },
          "event": "click"
        }
      }
    ],
    "expected_dialog": null,
    "expected_data": {
      "swatch_libraries.web_colors.swatches.3.name": "Navy Three",
      "swatch_libraries.web_colors.swatches.3.color": "#1a2b3c",
      "swatch_libraries.web_colors.swatches.2.name": "R=0 G=0 B=102",
      "swatch_libraries.web_colors.swatches.215.name": "R=255 G=255 B=255"
    }
  },
  {
    "name": "add_used_colors_appends_the_one_colour_the_library_lacks",
    "setup_svg": "paste_hidden_named_layer.svg",
    "note": "swatches.yaml menu Add Used Colors; actions.yaml swatch.add_used_colors appends each document colour the library lacks, sorted by hex, named 'R=r G=g B=b'. The document's blue is already web_colors' #0000ff, its green #008000 is not, so exactly one swatch is appended. Values from the reference.",
    "panel_state": {
      "swatches_panel_content": {
        "selected_library": "web_colors"
      }
    },
    "actions": [
      {
        "panel_menu": {
          "panel": "swatches_panel_content",
          "address": {
            "action": "add_used_colors"
          }
        }
      }
    ],
    "expected_data": {
      "swatch_libraries.web_colors.swatches.216": {
        "name": "R=0 G=128 B=0",
        "color": "#008000",
        "color_mode": "rgb",
        "color_type": "process",
        "global": false
      },
      "swatch_libraries.web_colors.swatches.-1.color": "#008000",
      "swatch_libraries.web_colors.swatches.215.name": "R=255 G=255 B=255"
    }
  }
]
