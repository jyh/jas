  {
    "name": "select_all_unused_brushes_skips_the_applied_brush",
    "setup_svg": "corner_path.svg",
    "note": "brush.select_unused: every slug no element carries as stroke_brush '<library>/<slug>'; the path carries default_brushes/oval_5pt after the apply.",
    "panel_state": {
      "brushes_panel_content": {
        "selected_library": "default_brushes",
        "selected_brushes": []
      }
    },
    "actions": [
      {
        "action": "select_all"
      },
      {
        "action": "apply_brush_to_selection",
        "params": {
          "library": "default_brushes",
          "brush_slug": "oval_5pt"
        }
      },
      {
        "panel_menu": {
          "panel": "brushes_panel_content",
          "address": {
            "action": "select_all_unused_brushes"
          }
        }
      }
    ],
    "expected_panel": {
      "brushes_panel_content": {
        "selected_brushes": [
          "basic",
          "round_3pt",
          "round_7pt",
          "flat_5pt",
          "round_10pt",
          "art_tapered",
          "pattern_diamonds",
          "bristle_round"
        ]
      }
    }
  },
  {
