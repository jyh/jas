  {
    "name": "duplicate_brush_inserts_a_copy_with_a_free_slug",
    "setup_svg": "corner_path.svg",
    "note": "brushes.yaml menu Duplicate Brush; brush.duplicate_selected: the copy right after its original, slug <slug>_copy, name '<name> copy'; the copies become the selection.",
    "panel_state": {
      "brushes_panel_content": {
        "selected_library": "default_brushes",
        "selected_brushes": [
          "round_3pt"
        ]
      }
    },
    "actions": [
      {
        "panel_menu": {
          "panel": "brushes_panel_content",
          "address": {
            "action": "duplicate_brush"
          }
        }
      }
    ],
    "expected_data": {
      "brush_libraries.default_brushes.brushes.2": {
        "name": "3 pt. Round copy",
        "slug": "round_3pt_copy",
        "type": "calligraphic",
        "angle": 0,
        "roundness": 100,
        "size": 3,
        "angle_variation": {
          "mode": "fixed"
        },
        "roundness_variation": {
          "mode": "fixed"
        },
        "size_variation": {
          "mode": "fixed"
        }
      },
      "brush_libraries.default_brushes.brushes.3.slug": "round_7pt"
    },
    "expected_panel": {
      "brushes_panel_content": {
        "selected_brushes": [
          "round_3pt_copy"
        ]
      }
    }
  },
  {
    "name": "delete_brush_removes_the_selected_slugs",
