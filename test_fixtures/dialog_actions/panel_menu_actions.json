[
  {
    "name": "duplicate_swatch_copies_each_selected_swatch_after_itself",
    "setup_svg": "rect_basic.svg",
    "note": "swatches.yaml menu Duplicate Swatch; actions.yaml swatch.duplicate_selected: indices ascending, each copy right after its original with a running offset, named '<name> copy'; the copies become the selection. Values from the reference (workspace_interpreter/effects.py).",
    "panel_state": {
      "swatches_panel_content": {
        "selected_library": "web_colors",
        "selected_swatches": [
          1,
          3
        ]
      }
    },
    "actions": [
      {
        "panel_menu": {
          "panel": "swatches_panel_content",
          "address": {
            "action": "duplicate_swatch"
          }
        }
      }
    ],
    "expected_data": {
      "swatch_libraries.web_colors.swatches.2": {
        "name": "R=0 G=0 B=51 copy",
        "color": "#000033",
        "color_mode": "web_safe_rgb",
        "color_type": "process",
        "global": false
      },
      "swatch_libraries.web_colors.swatches.5": {
        "name": "R=0 G=0 B=153 copy",
        "color": "#000099",
        "color_mode": "web_safe_rgb",
        "color_type": "process",
        "global": false
      },
      "swatch_libraries.web_colors.swatches.6.name": "R=0 G=0 B=204"
    },
    "expected_panel": {
      "swatches_panel_content": {
        "selected_swatches": [
          2,
          5
        ]
      }
    }
  },
  {
