   "element": {"type": "path", "d": [{"cmd": "M", "x": 0.0, "y": 0.0}, {"cmd": "C", "x1": 5.0, "y1": 10.0, "x2": 15.0, "y2": 10.0, "x": 20.0, "y": 0.0}], "fill": null, "stroke": null,
