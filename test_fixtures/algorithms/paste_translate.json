              "space": "rgb",
              "r": 1.0,
              "g": 0.0,
              "b": 0.0,
              "a": 1.0
            },
            "opacity": 1.0
          },
          "stroke": null,
          "opacity": 0.5,
          "transform": null,
          "locked": false,
          "visibility": "outline",
          "name": "port",
          "id": "op-back"
        },
        {
          "type": "rect",
          "x": 5.0,
          "y": 0.0,
          "width": 10.0,
          "height": 10.0,
          "rx": 0.0,
          "ry": 0.0,
          "fill": {
            "color": {
              "space": "rgb",
