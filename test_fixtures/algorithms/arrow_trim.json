    },
    {
      "name": "cubic_end_trim",
      "_comment": "Symmetric arch cubic; trim ~25% of arc off the end. Kept endpoint lands ON the curve (de Casteljau split), lifted off y=0, short of x=40 -- not the folded anchor the old shorten produced.",
      "start_setback": 0.0,
      "end_setback": 20.0,
      "element": {"type": "path", "d": [
