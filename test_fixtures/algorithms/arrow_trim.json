{
  "_doc": "Arc-length trim of arrowheaded stroke paths (ARROWTRIM). trim_path walks in from each armed end by the setback distance along arc length, de-Casteljau-splits the straddled segment, drops the tail, and butts the cut. Arc length uses the house FLATTEN_STEPS=20 uniform-t polyline (identical to flatten_path_commands / measure.arc_lengths / the dash-anchor walk), so the arc->parameter mapping is byte-reproducible across the active ports. Goldens are the trimmed command list pinned to the 4-decimal doc-space law. An empty result means the setbacks meet-or-exceed the total length: draw arrowheads only (oriented off the original path), no stroke.",
  "vectors": [
    {
      "name": "line_both_ends",
      "_comment": "100-long horizontal line, trim 10 off start and 20 off end -> M(10,0) L(80,0). Exact, hand-verifiable.",
      "start_setback": 10.0,
      "end_setback": 20.0,
      "element": {"type": "path", "d": [
        {"cmd": "M", "x": 0.0, "y": 0.0}, {"cmd": "L", "x": 100.0, "y": 0.0}
      ], "fill": null, "stroke": null, "opacity": 1.0, "transform": null, "locked": false, "visibility": "preview"},
      "expected": [{"cmd": "M", "x": 10.0, "y": 0.0}, {"cmd": "L", "x": 80.0, "y": 0.0}]
    },
    {
      "name": "line_start_only",
      "start_setback": 12.5,
      "end_setback": 0.0,
      "element": {"type": "path", "d": [
        {"cmd": "M", "x": 0.0, "y": 0.0}, {"cmd": "L", "x": 0.0, "y": 50.0}
      ], "fill": null, "stroke": null, "opacity": 1.0, "transform": null, "locked": false, "visibility": "preview"},
      "expected": [{"cmd": "M", "x": 0.0, "y": 12.5}, {"cmd": "L", "x": 0.0, "y": 50.0}]
    },
    {
      "name": "line_end_only",
      "start_setback": 0.0,
      "end_setback": 8.0,
      "element": {"type": "path", "d": [
        {"cmd": "M", "x": 10.0, "y": 10.0}, {"cmd": "L", "x": 10.0, "y": 40.0}
      ], "fill": null, "stroke": null, "opacity": 1.0, "transform": null, "locked": false, "visibility": "preview"},
      "expected": [{"cmd": "M", "x": 10.0, "y": 10.0}, {"cmd": "L", "x": 10.0, "y": 32.0}]
    },
    {
      "name": "corner_span_two_segments",
      "_comment": "Two 50-long legs; trim 10/10. Kept stroke spans the (50,0) corner joint.",
      "start_setback": 10.0,
      "end_setback": 10.0,
      "element": {"type": "path", "d": [
        {"cmd": "M", "x": 0.0, "y": 0.0}, {"cmd": "L", "x": 50.0, "y": 0.0}, {"cmd": "L", "x": 50.0, "y": 50.0}
