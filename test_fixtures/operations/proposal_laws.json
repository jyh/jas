[
  {
    "name": "accept_equals_hand: a proposal accepted lands as the same edit a hand would make, attributed to its proposer",
    "setup_svg": "two_rects.svg",
    "steps": [
      {
        "propose": {
          "id": "p1",
          "actor": "ai",
          "name": "move",
          "ops": [
            {
              "op": "select_rect",
              "x": 0,
              "y": 0,
              "width": 50,
              "height": 50,
              "extend": false
            },
            {
              "op": "move_selection",
              "dx": 10,
              "dy": 20
            }
          ]
        }
      },
      {
        "accept": "p1"
      }
    ],
    "equals_steps": [
      {
        "txn": {
          "name": "move",
          "ops": [
            {
              "op": "select_rect",
              "x": 0,
              "y": 0,
              "width": 50,
              "height": 50,
              "extend": false
            },
            {
              "op": "move_selection",
              "dx": 10,
              "dy": 20
            }
          ]
        }
      }
    ],
    "expect_actors": [
      "ai"
    ],
    "expect_refused": []
  },
