    "name": "scale_wrapped_off_wraps_the_untouched_rect",
    "setup_svg": "rect_with_id.svg",
    "ops": [
      {
        "op": "select_rect",
        "x": 0,
        "y": 0,
        "width": 96,
        "height": 96,
        "extend": false
      },
      {
        "op": "scale_transform",
