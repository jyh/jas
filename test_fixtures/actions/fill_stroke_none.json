[
  {
    "name": "set_fill_none_publishes_null_to_the_panel_scope",
    "setup_svg": "rect_with_stroke.svg",
    "actions": [
      {"action": "select_all", "params": {}},
      {"action": "set_fill_none", "params": {}}
    ],
    "expected_json": "fill_stroke_none_fill_expected.json",
    "expected_panel_state": {
      "fill_color": null,
      "stroke_color": "#000000"
    }
  },
  {
    "name": "set_stroke_none_publishes_null_to_the_panel_scope",
    "setup_svg": "rect_with_stroke.svg",
    "actions": [
      {"action": "select_all", "params": {}},
      {"action": "set_stroke_none", "params": {}}
    ],
    "expected_json": "fill_stroke_none_stroke_expected.json",
    "expected_panel_state": {
      "fill_color": "#0000ff",
      "stroke_color": null
    }
  },
  {
    "name": "set_active_color_still_publishes_the_colour",
    "setup_svg": "rect_with_stroke.svg",
    "actions": [
      {"action": "select_all", "params": {}},
      {"action": "set_active_color", "params": {"color": "#112233"}}
    ],
    "expected_json": "fill_stroke_none_recolor_expected.json",
    "expected_panel_state": {
      "fill_color": "#112233",
      "stroke_color": "#000000"
    }
  },
  {
    "name": "nothing_selected_publishes_the_seeded_app_default",
    "setup_svg": "rect_with_stroke.svg",
    "actions": [],
    "expected_json": "fill_stroke_none_noselection_expected.json",
    "expected_panel_state": {
      "fill_color": "#ffffff",
      "stroke_color": "#000000"
    }
  },
  {
    "name": "nothing_selected_and_fill_none_still_publishes_null",
    "setup_svg": "rect_with_stroke.svg",
    "actions": [
      {"action": "set_fill_none", "params": {}}
    ],
    "expected_json": "fill_stroke_none_noselection_expected.json",
    "expected_panel_state": {
      "fill_color": null,
      "stroke_color": "#000000"
    }
  }
]
