[
  {
    "name": "tile_panes",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "set_pane_position", "pane_id": 1, "x": 50.0, "y": 50.0},
      {"op": "tile_panes"}
    ],
    "expected_json": "pane_tile.json"
  },
  {
    "name": "toggle_canvas_maximized",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_canvas_maximized"}
    ],
    "expected_json": "pane_maximize.json"
  },
  {
    "name": "resize_pane",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "resize_pane", "pane_id": 2, "width": 300.0, "height": 800.0}
    ],
    "expected_json": "pane_resize.json"
  },
  {
    "name": "move_pane",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "set_pane_position", "pane_id": 0, "x": 100.0, "y": 50.0}
    ],
    "expected_json": "pane_move.json"
  },
  {
    "name": "hide_and_show_pane",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "hide_pane", "kind": "dock"},
      {"op": "show_pane", "kind": "dock"}
    ],
    "expected_json": "pane_hide_show.json"
  },
  {
    "name": "bring_pane_to_front",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "bring_pane_to_front", "pane_id": 0}
    ],
    "expected_json": "pane_bring_to_front.json"
  },
  {
    "name": "clamp_panes_in_a_viewport_smaller_than_the_margin",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "clamp_floating_docks", "viewport_w": 0.0, "viewport_h": 0.0}
    ],
    "expected_json": "pane_clamp_tiny.json"
  },
  {
    "name": "hide_toolbar",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "hide_pane", "kind": "toolbar"}
    ],
    "expected_json": "pane_hide_toolbar.json"
  },
  {
    "name": "toggle_pane_hides_a_visible_pane",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_pane", "kind": "toolbar"}
    ],
    "expected_json": "pane_hide_toolbar.json"
  },
  {
    "name": "toggle_pane_twice_shows_it_again",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_pane", "kind": "dock"},
      {"op": "toggle_pane", "kind": "dock"}
    ],
    "expected_json": "pane_hide_show.json"
  },
  {
    "name": "set_canvas_maximized_true_maximizes",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "set_canvas_maximized", "value": true}
    ],
    "expected_json": "pane_maximize.json"
  },
  {
    "name": "set_canvas_maximized_true_twice_stays_maximized",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "set_canvas_maximized", "value": true},
      {"op": "set_canvas_maximized", "value": true}
    ],
    "expected_json": "pane_maximize.json"
  },
  {
    "name": "set_canvas_maximized_false_after_maximize_restores",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_canvas_maximized"},
      {"op": "set_canvas_maximized", "value": false}
    ],
    "expected_json": "pane_hide_show.json"
  },
  {
    "name": "set_dock_collapsed_collapses_the_right_dock",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "set_dock_collapsed", "edge": "right", "value": true}
    ],
    "expected_json": "dock_collapsed_right.json"
  },
  {
    "name": "set_dock_collapsed_true_twice_stays_collapsed",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "set_dock_collapsed", "edge": "right", "value": true},
      {"op": "set_dock_collapsed", "edge": "right", "value": true}
    ],
    "expected_json": "dock_collapsed_right.json"
  },
  {
    "name": "toggle_dock_collapsed_collapses_the_right_dock",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_dock_collapsed", "edge": "right"}
    ],
    "expected_json": "dock_collapsed_right.json"
  },
  {
    "name": "toggle_dock_collapsed_twice_expands_it_again",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_dock_collapsed", "edge": "right"},
      {"op": "toggle_dock_collapsed", "edge": "right"}
    ],
    "expected_json": "pane_hide_show.json"
  },
  {
    "name": "set_dock_collapsed_false_after_a_toggle_expands_it",
    "setup": "workspace_default_with_panes.json",
    "ops": [
      {"op": "toggle_dock_collapsed", "edge": "right"},
      {"op": "set_dock_collapsed", "edge": "right", "value": false}
    ],
    "expected_json": "pane_hide_show.json"
  }
]
