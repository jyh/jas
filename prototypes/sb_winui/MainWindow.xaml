<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SbWinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FF101418">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
          THE SECOND COLUMN IS THE PANEL PANE (W2-5), and it is COLLAPSED unless
          the scene is the app. An Auto column holding a collapsed element takes
          no width, so every measurement scene keeps the surface it always had.
        -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--
          THE MENUBAR, AND IT IS EMPTY IN THIS FILE ON PURPOSE.

          Every item is materialized at runtime from the core's own compiled
          bundle: jas_menu_structure supplies the labels, shortcuts, dividers and
          submenu titles, jas_menu_state supplies enabled and checked, and the
          shell joins them on path. Authoring items here would re-author
          menubar.yaml a second time in a language with no conformance corpus,
          which is the exact defect the materializer law forbids and
          check_shell_no_interpreter.py gates.

          So this element is a MOUNT POINT. If it ever gains a child in this
          file, that gate should be the thing that says so.
        -->
        <MenuBar x:Name="Menu" Grid.Row="0" Grid.ColumnSpan="2" />

        <!--
          The canvas the Rust core draws into. Everything inside it is painted by
          Direct2D through a back buffer this shell owns; XAML draws none of it.
          That is the materializer claim made visible.

          THE STAR ROW IS ALSO O6's MECHANISM. Because this row takes whatever
          height is left, squeezing the window down to the status line's own
          height gives the panel ZERO, and `SizeChanged` fires with height 0
          through the real window manager rather than through a test hook.
        -->
        <SwapChainPanel x:Name="Canvas" Grid.Row="1" Grid.Column="0" />

        <!--
          ⚠️ THE HIT-TESTABILITY FALLBACK, AND IT IS COLLAPSED BY DEFAULT.

          A SwapChainPanel with no Background may not be hit-testable, and
          Background cannot be set on it (its own Remarks page). The docs do not
          settle it and the Mac this was written on cannot compile the shell, so
          the question is decided AT THE BOX: `SB_HIT=sibling` makes this Border
          visible and moves the SAME pointer handlers onto it. `Transparent` is
          load-bearing, because a null background is not hit-testable, which is
          the whole reason the panel is in question. (XML forbids a double hyphen
          inside a comment, so this file's prose uses none.)

          SAME GRID CELL as the panel, so it covers exactly the surface whose
          coordinates the handlers report (they always call
          GetCurrentPoint(Canvas), whichever element raised the event).
        -->
        <Border
            x:Name="HitShield"
            Grid.Row="1"
            Grid.Column="0"
            Background="Transparent"
            Visibility="Collapsed" />

        <!--
          THE PANEL PANE, AND IT IS A MOUNT POINT LIKE THE MENUBAR (W2-5).

          Every control inside it is materialized at runtime from the core's
          panel plan: jas_panel_plan supplies each control's canonical rect, its
          resolved values and its literal display strings, and a click is sent
          back as a widget id through jas_panel_behavior. Nothing here names a
          panel's content. LIGHT on purpose: the workspace icons draw in
          currentColor, and whether this platform's SVG reader honours that is
          read, not measured, so a dark default must still be legible.

          Its width is set in code from the width the plan is laid out at, so
          the number lives in one place. Visible only under SB_SCENE=app, and
          made visible BEFORE the first layout, so opening it resizes nothing.
        -->
        <Border
            x:Name="PaneHost"
            Grid.Row="1"
            Grid.Column="1"
            Background="#FFF3F3F3"
            BorderBrush="#FF2A2F36"
            BorderThickness="1,0,0,0"
            RequestedTheme="Light"
            Visibility="Collapsed">
            <!--
              W2b-2: THE PANEL SELECTOR sits above the plan. Its entries are the
              core's own list (jas_panel_list: content ids and summaries), so
              nothing here names a panel either; it stays disabled until that
              list has been read. One panel is shown at a time, and the width
              is the pane's, so choosing one resizes nothing.
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Name="PanePicker"
                    Grid.Row="0"
                    Margin="4,4,4,0"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False" />
                <ScrollViewer
                    x:Name="PaneScroll"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!--
          Status is XAML, not painted content, so a blank canvas over a healthy
          status line is a legible failure rather than an ambiguous one.
        -->
        <TextBlock
            x:Name="StatusLine"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="12,8"
            FontSize="14"
            Foreground="#CCFFFFFF"
            Text="starting" />
    </Grid>
</Window>
