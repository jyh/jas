<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SbWinUi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      A flat, saturated fill and nothing else. The point of checkpoint 1 is that
      a window APPEARS, so the content is chosen to be unmistakable in a desktop
      capture and to share no colour with the Windows shell around it.
    -->
    <Grid Background="#FF1B6AC9">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <TextBlock
                Text="JAS S-B MATERIALIZER"
                FontSize="34"
                FontWeight="SemiBold"
                Foreground="White"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="StatusLine"
                Text="checkpoint 1 — shell only, no D3D yet"
                FontSize="16"
                Foreground="#CCFFFFFF"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
